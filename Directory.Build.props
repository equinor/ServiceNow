<Project>
  <PropertyGroup>
    <!-- NuGet audit (NU1901-NU1904): keep as warnings so `-warnaserror` in CI
         doesn't fail on advisories; Dependabot handles vulnerable packages. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>
</Project>